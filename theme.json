                    "name": "Bordure"
                },
                {
                    "slug": "text",
                    "color": "#f2efe8",
                    "name": "Texte principal"
                },
                {
                    "slug": "text-secondary",
                    "color": "#9e9a8e",
                    "name": "Texte secondaire"
                },
                {
                    "slug": "text-muted",
                    "color": "#6b6860",
                    "name": "Texte atténué"
                }
