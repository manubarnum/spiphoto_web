            "fontSizes": [
                {
                    "slug": "xs",
                    "size": "0.75rem",
                    "name": "XS",
                    "fluid": false
                },
                {
                    "slug": "sm",
                    "size": "0.875rem",
                    "name": "Small",
                    "fluid": false
                },
                {
                    "slug": "md",
                    "size": "1rem",
                    "name": "Medium",
                    "fluid": false
                },
                {
                    "slug": "lg",
                    "size": "1.125rem",
                    "name": "Large",
                    "fluid": false
                },
                {
                    "slug": "xl",
                    "size": "1.25rem",
                    "name": "XL",
                    "fluid": false
                },
                {
                    "slug": "2xl",
                    "size": "1.5rem",
                    "name": "2XL",
                    "fluid": {
                        "min": "1.25rem",
                        "max": "1.5rem"
                    }
                },
                {
                    "slug": "3xl",
                    "size": "1.875rem",
                    "name": "3XL",
                    "fluid": {
                        "min": "1.5rem",
                        "max": "1.875rem"
                    }
                },
                {
                    "slug": "4xl",
                    "size": "2.25rem",
                    "name": "4XL",
                    "fluid": {
                        "min": "1.75rem",
                        "max": "2.25rem"
                    }
                },
                {
                    "slug": "5xl",
                    "size": "3rem",
                    "name": "5XL",
                    "fluid": {
                        "min": "2rem",
                        "max": "3rem"
                    }
                },
                {
                    "slug": "hero",
                    "size": "4.5rem",
                    "name": "Hero",
                    "fluid": {
                        "min": "2.5rem",
                        "max": "4.5rem"
                    }
                }
            ],
            "fluid": true,
            "fontStyle": true,
            "fontWeight": true,
            "letterSpacing": true,
            "lineHeight": true,
            "textDecoration": true,
            "textTransform": true,
            "dropCap": true,
            "customFontSize": true
        },
        "spacing": {
            "spacingSizes": [
                {
                    "slug": "1",
                    "size": "0.25rem",
                    "name": "1"
                },
                {
                    "slug": "2",
                    "size": "0.5rem",
                    "name": "2"
                },
                {
                    "slug": "3",
                    "size": "0.75rem",
                    "name": "3"
                },
                {
                    "slug": "4",
                    "size": "1rem",
                    "name": "4"
                },
                {
                    "slug": "5",
                    "size": "1.5rem",
                    "name": "5"
                },
                {
                    "slug": "6",
                    "size": "2rem",
                    "name": "6"
                },
                {
                    "slug": "7",
                    "size": "3rem",
                    "name": "7"
                },
                {
                    "slug": "8",
                    "size": "4rem",
                    "name": "8"
                },
                {
                    "slug": "9",
                    "size": "6rem",
                    "name": "9"
                }
            ],
            "padding": true,
            "margin": true,
            "blockGap": true,
            "units": [
                "px",
                "%",
                "em",
                "rem",
                "vw",
                "vmin"
            ],
            "customSpacingSize": true
        },
        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "shadow": {
            "defaultPresets": false
        },
        "custom": {
            "fontWeight": {
                "light": "300",
                "regular": "400",
                "medium": "500",
                "semibold": "600",
                "bold": "700",
                "extrabold": "800",
                "black": "900"
            },
            "lineHeight": {
                "tight": "1.2",
                "snug": "1.35",
                "normal": "1.65",
                "relaxed": "1.8",
                "loose": "2"
            },
            "letterSpacing": {
                "tight": "-0.03em",
                "normal": "0",
                "wide": "0.05em",
                "wider": "0.1em",
                "widest": "0.2em"
            }
        }
    },
    "styles": {
        "color": {
            "background": "var(--sp-bg)",
            "text": "var(--sp-text)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--source-serif)",
            "fontSize": "var(--wp--preset--font-size--md)",
            "lineHeight": "var(--wp--custom--line-height--normal)"
        },
        "spacing": {
            "blockGap": "var(--wp--preset--spacing--6)"
        },
        "elements": {
            "h1": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--playfair)",
                    "fontSize": "var(--wp--preset--font-size--hero)",
                    "fontWeight": "var(--wp--custom--font-weight--bold)",
                    "lineHeight": "var(--wp--custom--line-height--tight)",
                    "letterSpacing": "var(--wp--custom--letter-spacing--tight)"
                },
                "color": {
                    "text": "var(--sp-text)"
                }
            },
            "h2": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--playfair)",
                    "fontSize": "var(--wp--preset--font-size--5xl)",
                    "fontWeight": "var(--wp--custom--font-weight--bold)",
                    "lineHeight": "var(--wp--custom--line-height--tight)"
                },
                "color": {
                    "text": "var(--sp-text)"
                }
            },
            "h3": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--playfair)",
                    "fontSize": "var(--wp--preset--font-size--3xl)",
                    "fontWeight": "var(--wp--custom--font-weight--semibold)",
                    "lineHeight": "var(--wp--custom--line-height--snug)"
                },
                "color": {
                    "text": "var(--sp-text)"
                }
            },
            "h4": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--dm-sans)",
                    "fontSize": "var(--wp--preset--font-size--xl)",
                    "fontWeight": "var(--wp--custom--font-weight--semibold)"
                },
                "color": {
                    "text": "var(--sp-text)"
                }
            },
            "h5": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--dm-sans)",
                    "fontSize": "var(--wp--preset--font-size--lg)",
                    "fontWeight": "var(--wp--custom--font-weight--medium)"
                }
            },
            "h6": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--dm-sans)",
                    "fontSize": "var(--wp--preset--font-size--sm)",
                    "fontWeight": "var(--wp--custom--font-weight--semibold)",
                    "textTransform": "uppercase",
                    "letterSpacing": "var(--wp--custom--letter-spacing--wide)"
                }
            },
            "link": {
                "color": {
                    "text": "var(--sp-secondary)"
                },
                "typography": {
                    "textDecoration": "none"
                },
                ":hover": {
                    "color": {
                        "text": "var(--sp-secondary-dk)"
                    },
                    "typography": {
                        "textDecoration": "underline"
                    }
                }
            },
            "button": {
                "color": {
                    "background": "var(--sp-primary)",
                    "text": "var(--sp-on-brand)"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--dm-sans)",
                    "fontSize": "var(--wp--preset--font-size--sm)",
                    "fontWeight": "var(--wp--custom--font-weight--semibold)",
                    "textTransform": "uppercase",
                    "letterSpacing": "var(--wp--custom--letter-spacing--wide)"
                },
                "border": {
                    "radius": "3px",
                    "width": "0px"
                },
                "spacing": {
                    "padding": {
                        "top": "0.7rem",
                        "bottom": "0.7rem",
                        "left": "1.75rem",
                        "right": "1.75rem"
                    }
                },
                ":hover": {
                    "color": {
                        "background": "var(--sp-primary-dk)"
                    }
                }
            }
        },
        "blocks": {
            "core/post-title": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--playfair)",
                    "fontWeight": "var(--wp--custom--font-weight--bold)",
                    "lineHeight": "var(--wp--custom--line-height--tight)"
                },
                "color": {
                    "text": "var(--sp-text)"
                }
            },
            "core/paragraph": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--source-serif)",
                    "lineHeight": "var(--wp--custom--line-height--relaxed)"
                },
                "color": {
                    "text": "var(--sp-text)"
                }
            },
            "core/separator": {
                "color": {
                    "text": "var(--sp-border)"
                },
                "border": {
                    "color": "var(--sp-border)",
                    "width": "1px"
                }
            },
            "core/quote": {
                "color": {
                    "text": "var(--sp-text-sec)"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--playfair)",
                    "fontSize": "var(--wp--preset--font-size--2xl)",
                    "fontStyle": "italic",
                    "lineHeight": "var(--wp--custom--line-height--snug)"
                },
                "border": {
                    "left": {
                        "color": "var(--sp-secondary)",
                        "width": "4px",
                        "style": "solid"
                    },
                    "width": "0"
                },
                "spacing": {
                    "padding": {
                        "left": "var(--wp--preset--spacing--6)"
                    }
                }
            },
            "core/code": {
                "color": {
                    "background": "var(--sp-surface)",
                    "text": "var(--sp-secondary)"
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--sm)"
                },
                "border": {
                    "radius": "4px"
                },
                "spacing": {
                    "padding": {
                        "top": "0.875rem",
                        "bottom": "0.875rem",
                        "left": "1.25rem",
                        "right": "1.25rem"
                    }
                }
            }
        }
    },
    "customTemplates": [
        {
            "name": "blank",
            "title": "Vide",
            "postTypes": [
                "page",
                "post"
            ]
        },
        {
            "name": "full-width",
            "title": "Pleine largeur",
            "postTypes": [
                "page"
            ]
        },
        {
            "name": "no-sidebar",
            "title": "Sans sidebar",
            "postTypes": [
                "page",
                "post"
            ]
        }
    ],
    "templateParts": [
        {
            "name": "header",
            "title": "En-tête",
            "area": "header"
        },
        {
            "name": "footer",
            "title": "Pied de page",
            "area": "footer"
        }
    ]
}