                    "name": "Vert olive"
                },
                {
                    "slug": "primary-dark",
                    "color": "#3a4519",
                    "name": "Olive foncé"
                },
                {
                    "slug": "primary-light",
                    "color": "#6a7e30",
                    "name": "Olive clair"
                },
                {
                    "slug": "secondary",
                    "color": "#936893",
                    "name": "Mauve prune"
                },
                {
                    "slug": "secondary-dark",
                    "color": "#7a5579",
                    "name": "Mauve foncé"
                },
                {
                    "slug": "secondary-light",
                    "color": "#b08ab0",
                    "name": "Mauve clair"
                },
                {
                    "slug": "bg",
                    "color": "#0d0e09",
                    "name": "Fond"
                },
                {
                    "slug": "surface",
                    "color": "#161a0e",
                    "name": "Surface"
                },
                {
                    "slug": "surface-raised",
                    "color": "#1e2412",
                    "name": "Surface haute"
                },
                {
                    "slug": "surface-top",
                    "color": "#252c15",
                    "name": "Surface top"
                },
                {
                    "slug": "border",
